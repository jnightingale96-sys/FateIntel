# Copy this file to .env only when you need to override defaults.
# Do not place credentials in source control or diagnostic logs.

# Runtime
ENVIROCHEM_PORT=8792
ENVIROCHEM_ENVIRONMENT=local
ENVIROCHEM_DEBUG=false
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text

# Leave unset for the project-local SQLite database.
# DATABASE_URL=sqlite:///./data/envirochem.sqlite
# PostgreSQL example (requires requirements-optional-postgres.txt):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/envirochem

# Optional authorised local installations
ENVIROCHEM_SPIN_PATH=
ENVIROCHEM_PEARL_PATH=
ENVIROCHEM_SWASH_PATH=
ENVIROCHEM_MACRO_PATH=
ENVIROCHEM_TOXSWA_PATH=
ENVIROCHEM_GREATER_PATH=
ENVIROCHEM_PWC_PATH=
ENVIROCHEM_CHEMSTEER_PATH=
ENVIROCHEM_CEM_PATH=
ENVIROCHEM_EFAST_PATH=

# Controlled local execution bridge (OFF by default). The path must identify
# the exact separately installed executable. Command arguments and output globs
# are fixed server-side JSON arrays; the API cannot supply an arbitrary command.
# Enable only after validating the installed tool's genuine unattended/batch
# contract. GUI-only tools should use the generated handoff ZIP and file import.
ENVIROCHEM_EXTERNAL_EXECUTION_ENABLED=false
ENVIROCHEM_EXTERNAL_EXECUTION_TIMEOUT_SECONDS=900
ENVIROCHEM_PWC_COMMAND_ARGS_JSON=
ENVIROCHEM_PWC_OUTPUT_GLOBS_JSON=
ENVIROCHEM_CHEMSTEER_COMMAND_ARGS_JSON=
ENVIROCHEM_CHEMSTEER_OUTPUT_GLOBS_JSON=
ENVIROCHEM_CEM_COMMAND_ARGS_JSON=
ENVIROCHEM_CEM_OUTPUT_GLOBS_JSON=
ENVIROCHEM_EFAST_COMMAND_ARGS_JSON=
ENVIROCHEM_EFAST_OUTPUT_GLOBS_JSON=
# Illustrative contract syntax only (not a claim about an EPA executable CLI):
# ENVIROCHEM_PWC_COMMAND_ARGS_JSON=["--input","{manifest}","--output","{output_dir}"]
# ENVIROCHEM_PWC_OUTPUT_GLOBS_JSON=["output/**/*.csv","output/**/*.txt"]

# Optional native RDKit; browser RDKit.js remains the default
ENVIROCHEM_NATIVE_RDKIT=false

# Optional RSA-PSS signing for EnviroChem REACH review bundles.
# Use an absolute path to an unencrypted PEM private key. On POSIX systems the
# file must not be group- or world-readable. Never commit the key.
REACH_MANIFEST_PRIVATE_KEY_PATH=

# Interim transformation-pathway provider. ENVMICRO uses enviPath/EAWAG-derived
# data. Local/test evaluation is permitted only under the applicable terms;
# staging/production is blocked unless written commercial permission is held.
BIOTRANSFORMER_ENABLED=true
BIOTRANSFORMER_BASE_URL=https://biotransformer.ca
BIOTRANSFORMER_TIMEOUT_SECONDS=20
BIOTRANSFORMER_POLL_INTERVAL_SECONDS=1
BIOTRANSFORMER_MAX_WAIT_SECONDS=45
BIOTRANSFORMER_COMMERCIAL_LICENSE_CONFIRMED=false
