# Copy this file to .env only when you need to override defaults.
# Do not place credentials in source control or diagnostic logs.

# Runtime
FATEINTEL_PORT=8792
FATEINTEL_ENVIRONMENT=local
FATEINTEL_DEBUG=false
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text

# Leave unset for the project-local SQLite database.
# DATABASE_URL=sqlite:///./data/envirochem.sqlite
# PostgreSQL example (requires requirements-optional-postgres.txt):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/envirochem

# Optional authorised local installations. The legacy ENVIROCHEM_* names from
# v2.23 remain supported; use the FATEINTEL_* names for new installations.
FATEINTEL_SPIN_PATH=
FATEINTEL_PEARL_PATH=
FATEINTEL_SWASH_PATH=
FATEINTEL_MACRO_PATH=
FATEINTEL_TOXSWA_PATH=
FATEINTEL_PELMO_PATH=
FATEINTEL_GREATER_PATH=
FATEINTEL_PWC_PATH=
FATEINTEL_CHEMSTEER_PATH=
FATEINTEL_CEM_PATH=
FATEINTEL_EFAST_PATH=

# Controlled local execution bridge (OFF by default). The path must identify
# the exact separately installed executable. Command arguments and output globs
# are fixed server-side JSON arrays; the API cannot supply an arbitrary command.
# Enable only after validating the installed tool's genuine unattended/batch
# contract. GUI-only tools should use the generated handoff ZIP and file import.
FATEINTEL_EXTERNAL_EXECUTION_ENABLED=false
FATEINTEL_EXTERNAL_EXECUTION_TIMEOUT_SECONDS=900
FATEINTEL_PWC_COMMAND_ARGS_JSON=
FATEINTEL_PWC_OUTPUT_GLOBS_JSON=
FATEINTEL_CHEMSTEER_COMMAND_ARGS_JSON=
FATEINTEL_CHEMSTEER_OUTPUT_GLOBS_JSON=
FATEINTEL_CEM_COMMAND_ARGS_JSON=
FATEINTEL_CEM_OUTPUT_GLOBS_JSON=
FATEINTEL_EFAST_COMMAND_ARGS_JSON=
FATEINTEL_EFAST_OUTPUT_GLOBS_JSON=
# Illustrative contract syntax only (not a claim about an EPA executable CLI):
# FATEINTEL_PWC_COMMAND_ARGS_JSON=["--input","{manifest}","--output","{output_dir}"]
# FATEINTEL_PWC_OUTPUT_GLOBS_JSON=["output/**/*.csv","output/**/*.txt"]

# Optional native RDKit; browser RDKit.js remains the default
FATEINTEL_NATIVE_RDKIT=false

# Optional RSA-PSS signing for FateIntel REACH review bundles.
# Use an absolute path to an unencrypted PEM private key. On POSIX systems the
# file must not be group- or world-readable. Never commit the key.
REACH_MANIFEST_PRIVATE_KEY_PATH=

# Interim transformation-pathway provider. ENVMICRO uses enviPath/EAWAG-derived
# data. Local/test evaluation is permitted only under the applicable terms;
# staging/production is blocked unless written commercial permission is held.
BIOTRANSFORMER_ENABLED=true
BIOTRANSFORMER_BASE_URL=https://biotransformer.ca
BIOTRANSFORMER_TIMEOUT_SECONDS=20
BIOTRANSFORMER_POLL_INTERVAL_SECONDS=1
BIOTRANSFORMER_MAX_WAIT_SECONDS=45
BIOTRANSFORMER_COMMERCIAL_LICENSE_CONFIRMED=false

# Second transformation-pathway provider: curated-pathway search over enviPath's
# existing reviewed packages (e.g. EAWAG-BBD), plus its own rule-based
# prediction. envipath.org states it is free for academic and non-commercial
# use only and requires account registration; local/test evaluation is
# permitted, staging/production is blocked unless written commercial
# permission is held. An API token (generated from your own envipath.org
# account settings) is the recommended auth path -- username/password session
# login is an unverified fallback for older/self-hosted instances. Never
# commit real credentials here.
ENVIPATH_ENABLED=true
ENVIPATH_BASE_URL=https://envipath.org
ENVIPATH_API_TOKEN=
ENVIPATH_USERNAME=
ENVIPATH_PASSWORD=
ENVIPATH_TIMEOUT_SECONDS=20
ENVIPATH_COMMERCIAL_LICENSE_CONFIRMED=false

# MassBank Europe: analytical-identification's live product-ion-spectrum
# connector. Open REST API, no account or API key required.
MASSBANK_ENABLED=true
MASSBANK_BASE_URL=https://massbank.eu
MASSBANK_TIMEOUT_SECONDS=15

# US EPA Computational Toxicology and Exposure (CTX) APIs. Open for commercial and non-commercial use; an
# individual API key is required for the limited-access endpoints. Stored here only -- no live connector reads
# it yet (see app/config.py). Never commit a real key.
COMPTOX_API_KEY=
