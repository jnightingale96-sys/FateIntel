  "api_routes": [
    {
      "Object/action": "Package",
      "Method": "GET",
      "Route / client call": "/package/<uuid>",
      "Purpose": "Package metadata and contained object links"
    },
    {
      "Object/action": "Pathways in package",
      "Method": "GET",
      "Route / client call": "/package/<uuid>/pathway",
      "Purpose": "Observed or predicted pathways"
    },
    {
      "Object/action": "Compounds in package",
      "Method": "GET",
      "Route / client call": "/package/<uuid>/compound",
      "Purpose": "Compound records and structures"
    },
    {
      "Object/action": "Reactions in package",
      "Method": "GET",
      "Route / client call": "/package/<uuid>/reaction",
      "Purpose": "Substrate-product transformations"
    },
    {
      "Object/action": "Rules in package",
      "Method": "GET",
      "Route / client call": "/package/<uuid>/rule",
      "Purpose": "Biotransformation rules, generally SMIRKS-based"
    },
    {
      "Object/action": "Scenarios in package",
      "Method": "GET",
      "Route / client call": "/package/<uuid>/scenario",
      "Purpose": "Experimental/environmental metadata"
    },
    {
      "Object/action": "Search",
      "Method": "client/API",
      "Route / client call": "search(SMILES, packages)",
      "Purpose": "Structure search across selected packages"
    },
    {
      "Object/action": "Python package access",
      "Method": "Python",
      "Route / client call": "enviPath-python",
      "Purpose": "REST client; package/pathway/compound/rule extraction"
    }
  ],
